RewriteEngine On
RewriteBase /

# Don't rewrite existing files or directories (assets, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback: send everything else (including /commande-standard, /commande-plus, /commande-business) to index.html
RewriteRule ^ index.html [L]
